library(tidyverse)
library(janitor)
data <- read.csv("https://docs.google.com/spreadsheets/d/19uPs2FQIGtVuWZKBMBnahCRqlAFzQJdDnwjp6MApeC4/export?format=csv&gid=0")
data <- select(data, c(participant, fear, estimate))
view(data)
# frequency tables
#quick and easy:
table(data$fear, useNA = "always")
table(data$fear, useNA = "always") |> prop.table()
# the tidyverse way
data |>
tabyl(fear)
# Bar chart
data |>
drop_na(fear) |>
ggplot(aes(x = fear, fill = fear)) +
geom_bar(color = "dark grey") +
scale_fill_brewer(palette = "Set2", name="") +
labs(title = "Greatest Fears:", x = "", y = "") +
theme_light() +
geom_text(stat = "count",
aes(label = after_stat(paste0(round(100*count/sum(count)), "%"))),
position = position_stack(vjust = 0.5)) +
theme(axis.text = element_blank(),
axis.ticks = element_blank(),
panel.border = element_blank(),
panel.grid = element_blank())
# Pie chart:
data |>
drop_na(fear) |>
ggplot(aes(x = "", fill = fear)) +
geom_bar(color = "dark grey") +
coord_polar(theta = "y") +
scale_fill_brewer(palette = "Set2", name="") +
labs(title = "Greatest Fears:", x = "", y = "") +
theme_light() +
geom_text(stat = "count",
aes(label = after_stat(paste0(round(100*count/sum(count)), "%"))),
position = position_stack(vjust = 0.5)) +
theme(axis.text = element_blank(),
axis.ticks = element_blank(),
panel.border = element_blank(),
panel.grid = element_blank())
# Bar chart
data |>
drop_na(fear) |>
ggplot(aes(x = fear, fill = fear)) +
geom_bar(color = "dark grey") +
scale_fill_brewer(palette = "Set2", name="") +
labs(title = "Greatest Fears:", x = "", y = "") +
theme_light() +
geom_text(stat = "count",
aes(label = after_stat(paste0(round(100*count/sum(count)), "%"))),
position = position_stack(vjust = 0.5)) +
theme(axis.text = element_blank(),
axis.ticks = element_blank(),
panel.border = element_blank(),
panel.grid = element_blank())
# Stacked Bark Chart
data |>
drop_na(fear) |>
ggplot(aes(x = "", fill = fear)) +
geom_bar(color = "dark grey", width = .75) +
scale_fill_brewer(palette = "Set2", name="") +
labs(title = "Greatest Fears:", x = "", y = "") +
theme_light() +
geom_text(stat = "count",
aes(label = after_stat(paste0(round(100*count/sum(count)), "%"))),
position = position_stack(vjust = 0.5)) +
theme(axis.text = element_blank(),
axis.ticks = element_blank(),
panel.border = element_blank(),
panel.grid = element_blank())
# Quick and easy:
summary(data$estimate)
sd(data$estimate) |> round(2)
# The tidyverse way, plus breaking it down by group:
data |>
group_by(fear) |>
summarise(mean = mean(estimate),
sd = sd(estimate),
n = n())
# The tidyverse way, plus breaking it down by group:
data |>
# group_by(fear) |>
summarise(mean = mean(estimate),
sd = sd(estimate),
n = n())
# Quick and easy:
hist(data$estimate)
# The tidyverse way, plus breaking it down by group:
data |>
ggplot(aes(estimate)) +
facet_wrap(~ fear) +
geom_histogram(color = "black") +
theme_light()
