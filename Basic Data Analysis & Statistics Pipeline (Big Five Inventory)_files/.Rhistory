setwd("C:/Users/goula/Desktop/R_Psy/1st R project/Basic Data Analysis & Statistics Pipeline (Big Five Inventory)_files")
library(tidyverse)  # Good for data wrangling (dplyr) and visualization (ggplot2)
library(psych)  # Provides the 'bfi' dataset and psychometric functions
library(car)  # Provides advanced statistical tests like Levene's test for variance
data('bfi')
raw_data <- bfi
glimpse(raw_data)
summary(raw_data)
clean_data <- raw_data %>% # Convert 'gender' (1, 2) and 'education' (1-5) into factors (categorical variables)
mutate(
gender = factor(gender,
levels = c(1, 2),
labels = c("Male", "Female")),
education = factor(education,
levels = c(1, 2, 3, 4, 5),
labels = c("HS", "Finished HS", "Some College", "College Graduate", "Graduate Degree"))
) %>%
drop_na(gender, education, age) # Remove rows that have NA (missing values) in the 3 demographic columns. NOTE: We keep NAs in personality items for now to show how to handle them during scoring
# Define the keys for reverse scoring (-1 for reversed, 1 for normal) according to the BFI manual
items_keys <- c(
-1, 1, 1, 1, 1,  # A1 to A5  (A1 is reversed)
1, 1, 1, -1, -1,  # C1 to C5  (C4, C5 are reversed)
-1, -1, 1, 1, 1,  # E1 to E5  (E1, E2 are reversed)
1, 1, 1, 1, 1,  # N1 to N5  (No reversals)
1, -1, 1,  1, -1   # O1 to O5  (O2, O5 are reversed)
)
# Complete reverse coding pipeline
new_scored_data <- clean_data  %>%
# 1. Extract only the 25 personality items
select(A1:O5) %>%
# 2. Apply psych::reverse.code() using '.' to pipe the data into the 'items' argument
reverse.code(keys = items_keys, items = ., mini = 1, maxi = 6) %>%
# 3. Convert the resulting matrix back to a standard data frame
as.data.frame() %>%
# 4. Rename columns to match the original names (removing the appended '-')
setNames(colnames(clean_data %>%
select(A1:O5))) %>%
# 5. Re-attach the demographic variables we left behind
bind_cols(clean_data %>%
select(gender, education, age), .)
new_scored_data <- new_scored_data %>%
mutate(
Agreeableness = rowMeans(select(., A1, A2, A3, A4, A5), na.rm = TRUE)
Conscientiousness = rowMeans(select(., C1, C2, C3, C4, C5), na.rm = TRUE)
new_scored_data <- new_scored_data %>%
mutate(
Agreeableness = rowMeans(select(., A1, A2, A3, A4, A5), na.rm = TRUE),
Conscientiousness = rowMeans(select(., C1, C2, C3, C4, C5), na.rm = TRUE),
Extraversion = rowMeans(select(., E1, E2, E3, E4, E5), na.rm = TRUE),
Neuroticism = rowMeans(select(., N1, N2, N3, N4, N5), na.rm = TRUE),
Openness = rowMeans(select(., O1, O2, O3, O4, O5), na.rm = TRUE)
)
View(new_scored_data)
# Define the item sets for each scale (using the recoded/correct items)
traits_list <- list(
Agreeableness = select(scored_data, A1, A2, A3, A4, A5),
Conscientiousness = select(scored_data, C1, C2, C3, C4, C5),
Extraversion = select(scored_data, E1, E2, E3, E4, E5),
Neuroticism = select(scored_data, N1, N2, N3, N4, N5),
Openness = select(scored_data, O1, O2, O3, O4, O5)
